# Public Supabase config for the web app (Vite).
# Copy this file to `.env` and fill in your project's values.
# Only VITE_* vars are exposed to the client bundle.
# NEVER put the service_role / secret key or DB password here.
VITE_SUPABASE_URL=https://<your-project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
