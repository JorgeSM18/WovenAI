# Public Supabase config for the mobile app (Expo).
# Copy this file to `.env` and fill in your project's values.
# Only EXPO_PUBLIC_* vars are exposed to the client bundle.
# NEVER put the service_role / secret key or DB password here.
EXPO_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
