{
  "expo": {
    "name": "Woven",
    "slug": "woven",
    "scheme": "woven",
    "version": "0.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": ["expo-router", "expo-status-bar", "expo-secure-store"],
    "experiments": {
      "typedRoutes": true
    }
  }
}
