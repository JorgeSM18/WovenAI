{
  "name": "woven",
  "version": "0.0.0",
  "private": true,
  "description": "Woven — digital wardrobe with AI (monorepo root)",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:diff": "supabase db diff",
    "db:push": "supabase db push",
    "db:lint": "supabase db lint",
    "gen:types": "turbo run gen:types"
  },
  "devDependencies": {
    "@woven/config": "workspace:*",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "supabase": "^2.110.0",
    "turbo": "^2.3.0",
    "typescript": "^5.7.2"
  }
}
