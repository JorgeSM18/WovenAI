# Secrets for Supabase Edge Functions (local dev). Copy to `.env` in this folder
# and fill in — `.env` is gitignored, never commit real keys. For the hosted
# project use `supabase secrets set KEY=value` instead of a file.
#
# Serve locally with:
#   supabase functions serve --env-file supabase/functions/.env
#
# SUPABASE_URL and SUPABASE_ANON_KEY are injected by the CLI locally, so they
# don't need to be set here.

# Gemini API key for classify-garment (garment classification).
GEMINI_KEY=

# Base URL of the self-hosted rembg service for remove-background
# (e.g. http://host.docker.internal:7000 when running rembg on the host).
REMBG_URL=
